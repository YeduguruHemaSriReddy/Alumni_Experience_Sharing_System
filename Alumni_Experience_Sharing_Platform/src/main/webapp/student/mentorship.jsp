<html>

<head>

<title>Mentorship Request</title>

<style>

body{
font-family:Arial;
background:#f4f6f9;
}

.form{
width:400px;
margin:auto;
background:white;
padding:20px;
border-radius:8px;
margin-top:50px;
}

input,textarea{
width:100%;
padding:10px;
margin:10px 0;
}

button{
background:#007bff;
color:white;
border:none;
padding:10px;
width:100%;
}

</style>

</head>

<body>

<div class="form">

<h2>Request Mentorship</h2>

<form action="../requestMentorship" method="post">

<input type="number" name="alumniId" placeholder="Enter Alumni ID">

<textarea name="message" placeholder="Write your message"></textarea>

<button type="submit">Send Request</button>

</form>

</div>

</body>

</html>